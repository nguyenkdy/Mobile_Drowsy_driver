<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B0000"> <TextView
    android:id="@+id/tvLiveHeader"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:text="🔴 KÊNH GIÁM SÁT TRỰC TIẾP (LIVE)"
    android:textColor="#FF5252"
    android:textSize="20sp"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/playerContainerLive"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnBackToRoutine"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLiveHeader"
        app:strokeColor="#FF5252"
        app:strokeWidth="2dp">

        <com.google.android.exoplayer2.ui.StyledPlayerView
            android:id="@+id/livePlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:shutter_background_color="@android:color/black"
            app:use_controller="false" /> </com.google.android.material.card.MaterialCardView>

    <ProgressBar
        android:id="@+id/liveProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="#FF5252"
        app:layout_constraintBottom_toBottomOf="@id/playerContainerLive"
        app:layout_constraintEnd_toEndOf="@id/playerContainerLive"
        app:layout_constraintStart_toStartOf="@id/playerContainerLive"
        app:layout_constraintTop_toTopOf="@id/playerContainerLive" />

    <Button
        android:id="@+id/btnBackToRoutine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#424242"
        android:text="Quay lại Routine"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>